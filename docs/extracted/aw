#!/usr/bin/env bash
# aw — agent worktree dispatcher
#
# One task = one worktree = one branch = one reviewable diff.
# Your working tree is never touched by an agent.
#
#   aw plan  "streaming resampler"   start an architect session
#   aw scout "where is decode_flac"  one-shot cheap lookup
#   aw new   0007-c                  create worktree + branch for a task
#   aw run   0007-c                  run the implementer in that worktree
#   aw check 0007-c                  run the reviewer against the diff
#   aw diff  0007-c                  open the diff in $EDITOR
#   aw land  0007-c                  merge to current branch, remove worktree
#   aw drop  0007-c                  discard worktree and branch
#   aw ls                            list active agent worktrees
#   aw gate                          run the gate here
#   aw tier  lean|standard|deep      set model tier for this shell
#   aw zone  <path>                  which zone does this path belong to
#   aw install-hooks                 install the hand-zone commit guard

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "aw: not inside a git repository" >&2; exit 1; }
cd "$ROOT"

AGENTS_DIR="$ROOT/.agents"
WT_ROOT="${LOOM_WORKTREES:-$(dirname "$ROOT")/.loom-worktrees/$(basename "$ROOT")}"
mkdir -p "$WT_ROOT" 2>/dev/null || true
WT_ROOT="$(cd "$WT_ROOT" 2>/dev/null && pwd -P || echo "$WT_ROOT")"
TIER="${LOOM_TIER:-standard}"
MAX_ATTEMPTS="${LOOM_MAX_ATTEMPTS:-3}"

die() { echo "aw: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- model tiers
# Ordered fallback lists. First entry whose API key is present wins.
models_for() {
  local role="$1"
  case "$TIER:$role" in
    deep:architect)      echo "anthropic/claude-fable-5 anthropic/claude-opus-5 zai/glm-4.6" ;;
    standard:architect)  echo "anthropic/claude-fable-5 zai/glm-4.6 moonshot/kimi-k2.5" ;;
    lean:architect)      echo "zai/glm-4.6 moonshot/kimi-k2.5 deepseek/deepseek-reasoner" ;;

    deep:implementer)    echo "moonshot/kimi-k2.5 zai/glm-4.6" ;;
    standard:implementer|lean:implementer)
                         echo "zai/glm-4.6 deepseek/deepseek-chat moonshot/kimi-k2.5" ;;

    deep:reviewer)       echo "anthropic/claude-sonnet-5 moonshot/kimi-k2.5" ;;
    standard:reviewer)   echo "moonshot/kimi-k2.5 deepseek/deepseek-reasoner" ;;
    lean:reviewer)       echo "deepseek/deepseek-chat" ;;

    *:scout)             echo "deepseek/deepseek-chat zai/glm-4.6-air" ;;
    *)                   echo "zai/glm-4.6" ;;
  esac
}

key_for_provider() {
  case "$1" in
    anthropic) echo "${ANTHROPIC_API_KEY:-}" ;;
    zai)       echo "${ZAI_API_KEY:-}" ;;
    moonshot)  echo "${MOONSHOT_API_KEY:-}" ;;
    deepseek)  echo "${DEEPSEEK_API_KEY:-}" ;;
    *)         echo "x" ;;
  esac
}

pick_model() {
  local role="$1" m provider
  for m in $(models_for "$role"); do
    provider="${m%%/*}"
    [ -n "$(key_for_provider "$provider")" ] && { echo "$m"; return 0; }
  done
  die "no usable model for role '$role' at tier '$TIER' — no API key set"
}

# ---------------------------------------------------------------------- zones
zone_of() {
  local path="$1" zones="$AGENTS_DIR/zones.toml" current="" p
  [ -f "$zones" ] || { echo "assist"; return; }
  # Deliberately simple: last matching zone wins, hand checked first elsewhere.
  local result="assist"
  while IFS= read -r line; do
    case "$line" in
      \[*\]) current="${line//[\[\]]/}" ;;
      *reason*) ;;
      *paths*|*\"*)
        for p in $(echo "$line" | grep -o '"[^"]*"' | tr -d '"'); do
          case "$path" in
            $p) result="$current" ;;
          esac
        done
        ;;
    esac
  done < "$zones"
  echo "$result"
}

# ----------------------------------------------------------------- worktrees
wt_path() { echo "$WT_ROOT/$1"; }
branch_of() { echo "agent/$1"; }

cmd_new() {
  local task="${1:?usage: aw new <task-id>}"
  local wt br
  wt="$(wt_path "$task")"; br="$(branch_of "$task")"
  [ -d "$wt" ] && die "worktree already exists: $wt"
  [ -f "$AGENTS_DIR/tasks/$task.md" ] || die "no task file: .agents/tasks/$task.md"
  mkdir -p "$(dirname "$wt")"
  git worktree add -b "$br" "$wt" HEAD
  echo "$wt"
}

cmd_run() {
  local task="${1:?usage: aw run <task-id>}"
  local wt br model attempt=1
  wt="$(wt_path "$task")"; br="$(branch_of "$task")"
  [ -d "$wt" ] || wt="$(cmd_new "$task" | tail -1)"
  model="$(pick_model implementer)"

  echo "aw: task $task  branch $br  model $model  tier $TIER"

  while [ "$attempt" -le "$MAX_ATTEMPTS" ]; do
    echo "aw: attempt $attempt/$MAX_ATTEMPTS"
    ( cd "$wt" && opencode run \
        --agent implementer \
        --model "$model" \
        "Implement the task in .agents/tasks/$task.md. Read the plan it \
references first. Touch only the files it lists. Run ./.agents/gate.sh until it \
exits 0. Write your notes to .agents/reviews/$task-done.md when finished." )

    if ( cd "$wt" && ./.agents/gate.sh >/dev/null 2>&1 ); then
      echo "aw: gate green"
      ( cd "$wt" && git add -A && git commit -q -m "agent($task): $(head -1 "$AGENTS_DIR/tasks/$task.md" | sed 's/^#\s*//')" )
      echo "aw: committed on $br — review with: aw diff $task"
      return 0
    fi
    [ -f "$wt/.agents/reviews/$task-blocked.md" ] && {
      echo "aw: implementer reported blocked — see .agents/reviews/$task-blocked.md"; return 2; }
    attempt=$((attempt + 1))
  done

  echo "aw: gate never went green after $MAX_ATTEMPTS attempts." >&2
  echo "aw: this usually means the task spec is wrong. Revisit it with the architect." >&2
  return 1
}

cmd_check() {
  local task="${1:?usage: aw check <task-id>}"
  local wt br model
  wt="$(wt_path "$task")"; br="$(branch_of "$task")"
  [ -d "$wt" ] || die "no worktree for $task"
  model="$(pick_model reviewer)"
  echo "aw: reviewing $task with $model"
  ( cd "$wt" && git diff HEAD~1 > /tmp/aw-$task.diff 2>/dev/null || git diff > /tmp/aw-$task.diff )
  ( cd "$wt" && opencode run \
      --agent reviewer \
      --model "$model" \
      "Review the diff at /tmp/aw-$task.diff against .agents/tasks/$task.md. \
Write your verdict to .agents/reviews/$task-review.md." )
  cat "$wt/.agents/reviews/$task-review.md" 2>/dev/null || true
}

cmd_diff() {
  local task="${1:?usage: aw diff <task-id>}"
  local br; br="$(branch_of "$task")"
  if have nvim; then
    nvim -c "DiffviewOpen HEAD..$br" 2>/dev/null \
      || nvim -c "term git diff HEAD..$br" -c "startinsert"
  else
    git diff "HEAD..$br" | ${PAGER:-less}
  fi
}

cmd_land() {
  local task="${1:?usage: aw land <task-id>}"
  local wt br; wt="$(wt_path "$task")"; br="$(branch_of "$task")"
  git merge --no-ff "$br" -m "land($task)"
  git worktree remove "$wt" --force
  git branch -d "$br"
  # tick the checkbox in the plan
  local plan; plan="$(grep -rl "$task" "$AGENTS_DIR/plans" 2>/dev/null | head -1 || true)"
  [ -n "$plan" ] && sed -i "s/- \[ \] $task/- [x] $task/" "$plan"
  echo "aw: landed $task"
}

cmd_drop() {
  local task="${1:?usage: aw drop <task-id>}"
  local wt br; wt="$(wt_path "$task")"; br="$(branch_of "$task")"
  git worktree remove "$wt" --force 2>/dev/null || true
  git branch -D "$br" 2>/dev/null || true
  echo "aw: dropped $task"
}

cmd_ls() {
  git worktree list | grep -F "$WT_ROOT" || echo "(no agent worktrees)"
}

cmd_plan() {
  local topic="${*:?usage: aw plan \"<topic>\"}"
  local model; model="$(pick_model architect)"
  echo "aw: architect on $model (tier $TIER)"
  opencode --agent architect --model "$model" \
    --prompt "Design: $topic. Use the scout subagent for codebase questions \
rather than reading files yourself. Produce a plan under .agents/plans/ and \
task files under .agents/tasks/. Respect .agents/zones.toml."
}

cmd_scout() {
  local q="${*:?usage: aw scout \"<question>\"}"
  local model; model="$(pick_model scout)"
  opencode run --agent scout --model "$model" "$q"
}

cmd_gate() { exec "$AGENTS_DIR/gate.sh"; }

cmd_zone() {
  local p="${1:?usage: aw zone <path>}"
  p="$(realpath --relative-to="$ROOT" "$p" 2>/dev/null || echo "$p")"
  echo "$p → $(zone_of "$p")"
}

cmd_tier() {
  local t="${1:?usage: aw tier lean|standard|deep}"
  case "$t" in lean|standard|deep) ;; *) die "unknown tier: $t" ;; esac
  echo "export LOOM_TIER=$t"
  echo "# run: eval \"\$(aw tier $t)\"" >&2
}

cmd_install_hooks() {
  local hook="$ROOT/.git/hooks/pre-commit"
  cat > "$hook" << 'HOOK'
#!/usr/bin/env bash
# Reject agent commits that touch hand-zone paths.
set -e
branch="$(git rev-parse --abbrev-ref HEAD)"
case "$branch" in agent/*) ;; *) exit 0 ;; esac
root="$(git rev-parse --show-toplevel)"
zones="$root/.agents/zones.toml"
[ -f "$zones" ] || exit 0
hand_globs="$(awk '/^\[hand\]/{f=1;next} /^\[/{f=0} f && !/^[[:space:]]*reason[[:space:]]*=/' "$zones" \
              | grep -o '"[^"]*"' | tr -d '"')"
violations=""
while IFS= read -r file; do
  for g in $hand_globs; do
    case "$file" in $g) violations="$violations  $file";; esac
  done
done < <(git diff --cached --name-only)
if [ -n "$violations" ]; then
  echo "BLOCKED: agent branch '$branch' touches hand-zone paths:" >&2
  echo "$violations" >&2
  echo "" >&2
  echo "These are yours to write. Reassign the task or reclassify the zone" >&2
  echo "deliberately in .agents/zones.toml." >&2
  exit 1
fi
HOOK
  chmod +x "$hook"
  echo "aw: installed $hook"
}

# ------------------------------------------------------------------ dispatch
case "${1:-}" in
  new)   shift; cmd_new "$@" ;;
  run)   shift; cmd_run "$@" ;;
  check) shift; cmd_check "$@" ;;
  diff)  shift; cmd_diff "$@" ;;
  land)  shift; cmd_land "$@" ;;
  drop)  shift; cmd_drop "$@" ;;
  ls)    shift; cmd_ls "$@" ;;
  plan)  shift; cmd_plan "$@" ;;
  scout) shift; cmd_scout "$@" ;;
  gate)  shift; cmd_gate "$@" ;;
  zone)  shift; cmd_zone "$@" ;;
  tier)  shift; cmd_tier "$@" ;;
  install-hooks) shift; cmd_install_hooks "$@" ;;
  ""|-h|--help|help) sed -n '2,25p' "$0" | sed 's/^# \?//' ;;
  *) die "unknown command '$1' — try: aw help" ;;
esac
