{
  "$schema": "https://opencode.ai/config.json",

  "// NOTE": "Model IDs move fast. Run `opencode models` and verify before trusting these.",

  "model": "zai/glm-4.6",
  "subagent_depth": 1,

  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },

    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-4.6": { "name": "GLM 4.6" },
        "glm-4.6-air": { "name": "GLM 4.6 Air" }
      }
    },

    "moonshot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Moonshot",
      "options": {
        "baseURL": "https://api.moonshot.ai/v1",
        "apiKey": "{env:MOONSHOT_API_KEY}"
      },
      "models": {
        "kimi-k2.5": { "name": "Kimi K2.5" },
        "kimi-k2-turbo-preview": { "name": "Kimi K2 Turbo" }
      }
    },

    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-chat": { "name": "DeepSeek V3" },
        "deepseek-reasoner": { "name": "DeepSeek R1" }
      }
    }
  },

  "agent": {
    "architect": {
      "description": "Designs features. Writes plans and task specs. Never edits source.",
      "mode": "primary",
      "model": "anthropic/claude-fable-5",
      "temperature": 0.3,
      "prompt": "{file:./prompts/architect.md}",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "allow"
      }
    },

    "build": {
      "description": "General hands-on work under your direct supervision.",
      "mode": "primary",
      "model": "zai/glm-4.6",
      "temperature": 0.2,
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },

    "scout": {
      "description": "Read-only codebase exploration. Answers where/what/who-calls questions with file:line citations. Use this instead of reading files yourself.",
      "mode": "subagent",
      "model": "deepseek/deepseek-chat",
      "temperature": 0.1,
      "prompt": "{file:./prompts/scout.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "allow"
      }
    },

    "implementer": {
      "description": "Implements exactly one task file inside its own worktree. Must pass the gate.",
      "mode": "subagent",
      "model": "zai/glm-4.6",
      "temperature": 0.15,
      "prompt": "{file:./prompts/implementer.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },

    "reviewer": {
      "description": "Reviews a diff against its task spec. Runs on a different provider than the implementer so failure modes are decorrelated.",
      "mode": "subagent",
      "model": "moonshot/kimi-k2.5",
      "temperature": 0.1,
      "prompt": "{file:./prompts/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    }
  }
}
